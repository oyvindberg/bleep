[3.997775, "o", "\u001b]10;?\u0007\u001b]11;?\u0007\u001b[c"]
[5.016981, "o", "\u001b[38;2;131;148;150m─────┬────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n     \u001b[38;2;131;148;150m│ \u001b[0mFile: \u001b[1mprompt.txt\u001b[0m\r\n\u001b[38;2;131;148;150m─────┼────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[5.017073, "o", "\u001b[38;2;131;148;150m   1\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242mScripted demo - follow EXACTLY, no improvisation, edit no files.\u001b[0m\r\n\u001b[38;2;131;148;150m   2\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242mThe cwd is a compiled bleep repo (MAIN); its absolute path is `pwd`.\u001b[0m\r\n"]
[5.017078, "o", "\u001b[38;2;131;148;150m   3\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \r\n"]
[5.01709, "o", "\u001b[38;2;131;148;150m   4\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m1. Run: git worktree add -b seeded ../wt-seeded\u001b[0m\r\n\u001b[38;2;131;148;150m   5\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m        git worktree add -b cold   ../wt-cold\u001b[0m\r\n"]
[5.017092, "o", "\u001b[38;2;131;148;150m   6\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \r\n"]
[5.017111, "o", "\u001b[38;2;131;148;150m   7\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m2. Spawn two subagents IN PARALLEL (one message, two Agent calls):\u001b[0m\r\n\u001b[38;2;131;148;150m   8\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \r\n\u001b[38;2;131;148;150m   9\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   - seeded: \"Using the bleep MCP tools: call copy-state with\u001b[0m\r\n"]
[5.017129, "o", "\u001b[38;2;131;148;150m  10\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m     directory=<MAIN>/../wt-seeded and from=<MAIN>, then call compile\u001b[0m\r\n\u001b[38;2;131;148;150m  11\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m     for the same directory. Report both results verbatim.\"\u001b[0m\r\n"]
[5.017132, "o", "\u001b[38;2;131;148;150m  12\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \r\n"]
[5.017135, "o", "\u001b[38;2;131;148;150m  13\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   - cold: \"Using the bleep MCP tools: call compile with\u001b[0m\r\n"]
[5.017148, "o", "\u001b[38;2;131;148;150m  14\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m     directory=<MAIN>/../wt-cold. Do NOT call copy-state - this\u001b[0m\r\n\u001b[38;2;131;148;150m  15\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m     worktree deliberately starts cold. Report the result verbatim.\"\u001b[0m\r\n\u001b[38;2;131;148;150m  16\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \r\n"]
[5.017165, "o", "\u001b[38;2;131;148;150m  17\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m3. Each reports historyId=1 in its own worktree. Ask bleep to compare\u001b[0m\r\n\u001b[38;2;131;148;150m  18\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   the two runs: call the history diff-timing tool with\u001b[0m\r\n"]
[5.017168, "o", "\u001b[38;2;131;148;150m  19\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   directory=<MAIN>/../wt-seeded, base=1, target=1,\u001b[0m\r\n"]
[5.017171, "o", "\u001b[38;2;131;148;150m  20\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   baseDirectory=<MAIN>/../wt-cold.\u001b[0m\r\n"]
[5.017189, "o", "\u001b[38;2;131;148;150m  21\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \r\n\u001b[38;2;131;148;150m  22\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m4. Print exactly this, with real numbers from the tool results:\u001b[0m\r\n\u001b[38;2;131;148;150m  23\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   agent[seeded]  copy-state: <bytes> bytes in <ms>  ->  first compile: success\u001b[0m\r\n"]
[5.017191, "o", "\u001b[38;2;131;148;150m  24\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   agent[cold]    first compile: success (compiled everything from scratch)\u001b[0m\r\n"]
[5.017208, "o", "\u001b[38;2;131;148;150m  25\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   bleep history diff-timing (cold -> seeded): total <totalBaseMs>ms -> <totalTargetMs>ms\u001b[0m\r\n\u001b[38;2;131;148;150m  26\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242m   verdict: <one sentence with the ratio>\u001b[0m\r\n\u001b[38;2;131;148;150m  27\u001b[0m \u001b[38;2;131;148;150m│\u001b[0m \u001b[38;2;248;248;242mThen stop.\u001b[0m\r\n"]
[5.017227, "o", "\u001b[38;2;131;148;150m─────┴────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[5.018954, "o", "\r\n"]
