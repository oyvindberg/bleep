[22.230726, "o", "\u001b[1mdiff --git a/mathy/src/scala/com/example/Pricing.scala b/mathy/src/scala/com/example/Pricing.scala\u001b[m\r\n\u001b[1mindex 460a3d4..ecf4ace 100644\u001b[m\r\n\u001b[1m--- a/mathy/src/scala/com/example/Pricing.scala\u001b[m\r\n\u001b[1m+++ b/mathy/src/scala/com/example/Pricing.scala\u001b[m\r\n\u001b[36m@@ -3,7 +3,7 @@\u001b[m \u001b[mpackage com.example\u001b[m\r\n object Pricing:\u001b[m\r\n   /** 10% off for orders of 100 or more */\u001b[m\r\n   def discount(orderTotal: Int): Int =\u001b[m\r\n\u001b[31m-    if orderTotal >= 100 then orderTotal * 10 / 100\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if orderTotal >= 100 then orderTotal * 15 / 100\u001b[m\r\n     else 0\u001b[m\r\n \u001b[m\r\n   def total(orderTotal: Int): Int =\u001b[m\r\n"]
